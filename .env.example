LEO_MODE=all
LEO_HTTP_ADDR=:8080
LEO_DATABASE_URL=postgres://leonardo:leonardo@postgres:5432/leonardo?sslmode=disable
LEO_DATABASE_MAX_CONNS=64
LEO_POSTGRES_HOST_PORT=15432
LEO_REDIS_HOST_PORT=16379
# Optional external services (override the Compose-local defaults)
# LEO_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:15432/leonardo?sslmode=disable
# LEO_REDIS_ADDR=127.0.0.1:16379
# LEO_REDIS_PASSWORD=
LEO_REDIS_ADDR=redis:6379
LEO_REDIS_PASSWORD=
LEO_REDIS_DB=0
LEO_MASTER_KEY=replace-with-base64-encoded-32-byte-key
LEO_ADMIN_USERNAME=admin
LEO_ADMIN_PASSWORD=change-me-now
LEO_SESSION_SYNC_TOKEN=replace-with-a-random-32-byte-token
LEO_PUBLIC_BASE_URL=http://127.0.0.1:8080
LEO_SCHEMA_VERSION=1.258.0
LEO_SYNC_TIMEOUT=180s
LEO_POLL_INTERVAL=3s
LEO_TASK_TIMEOUT=30m
LEO_TASK_LEASE=60s
LEO_QUEUE_TIMEOUT=30m
LEO_BALANCE_RECONCILE_DELAY=2s
LEO_BALANCE_REFRESH_WORKERS=32
LEO_BALANCE_REFRESH_PER_PROXY=1
LEO_PROXY_CONTROL_MIN_INTERVAL=20s
LEO_PROXY_CONTROL_LEASE=90s
LEO_TASK_DISPATCHER_CONCURRENCY=128
LEO_API_KEY_QUEUE_MULTIPLIER=2
LEO_UNCERTAIN_ACCOUNT_LIMIT=1
LEO_UNCERTAIN_PROXY_LIMIT=3
LEO_UNCERTAIN_PROVIDER_LIMIT=5
LEO_SHARED_CIRCUIT_WINDOW=30s
LEO_SHARED_CIRCUIT_COOLDOWN=1m
LEO_PROVIDER_CIRCUIT_FAILURES=5
LEO_PROXY_CIRCUIT_FAILURES=3
LEO_GENERATION_INFLIGHT=200
LEO_MULTIPART_INFLIGHT=8
LEO_SYNC_INFLIGHT=10
LEO_REQUEST_LOG_WORKERS=4
LEO_REQUEST_LOG_BUFFER=4096
LEO_SESSION_REFRESH_AHEAD=15m
LEO_MAX_IMAGE_BYTES=26214400
LEO_MAX_VIDEO_BYTES=209715200
LEO_MAX_AUDIO_BYTES=52428800
LEO_MAX_MULTIPART_BYTES=419430400
LEO_TASK_ASSET_DIR=/data/task-assets
LEO_HISTORY_CLEANUP_INTERVAL=1h
LEO_HISTORY_CLEANUP_BATCH=10000
LEO_TASK_EVENT_RETENTION=2160h
LEO_OUTBOX_RETENTION=720h
LEO_SESSION_JOB_RETENTION=720h
LEO_API_REQUEST_LOG_RETENTION=720h
LEO_AUDIT_LOG_RETENTION=8760h
LEO_RECONCILIATION_RETENTION=17520h
LEO_LOG_LEVEL=info
LEO_COOKIE_SECURE=false
# Production HTTPS behind a reverse proxy:
# LEO_HTTP_ADDR=127.0.0.1:18080
# LEO_PUBLIC_BASE_URL=https://api.example.com
# LEO_COOKIE_SECURE=true
LEO_RATE_LIMIT_PER_MINUTE=60
LEO_RATE_LIMIT_PER_HOUR=1000
LEO_DAILY_IMAGE_LIMIT=100
LEO_IP_RATE_LIMIT_PER_MINUTE=120
LEO_ACCOUNT_SUBMIT_INTERVAL=8s
LEO_CIRCUIT_FAILURES=3
LEO_CIRCUIT_COOLDOWN=10m
LEO_UPSTREAM_429_COOLDOWN=2m
